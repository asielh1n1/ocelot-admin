<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SamplePlugin</AssemblyName>
    <RootNamespace>SamplePlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      In this repository the sample references the contract project directly.
      A third-party plugin would instead reference the published NuGet package:

        <PackageReference Include="ocelot-admin-plugin" Version="1.0.0">
          <ExcludeAssets>runtime</ExcludeAssets>
          <Private>false</Private>
        </PackageReference>

      Private=false + ExcludeAssets=runtime are REQUIRED either way: they stop the contract
      assembly from being copied into Plugins/, which would load a second copy of
      ApiGateway.Contracts and break every type check (IsAssignableFrom returns false for
      types with the same name from different assembly instances).
    -->
    <ProjectReference Include="..\..\ApiGateway.Contracts\ApiGateway.Contracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
